# Copy to .env and fill in. .env is never committed; the repo is public.

# Long random value, e.g. from:
#   docker compose run --rm --no-deps web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
# 1 only for development
DJANGO_DEBUG=1

# Public host name: mymvz.jnsw.de first, later mymvz.de (#10)
SITE_HOST=mymvz.jnsw.de
# Start of links in e-mails (optional, default https://SITE_HOST).
# In development e.g. http://localhost:8000
SITE_BASE_URL=
# More host names, comma-separated (optional). With the voice agent in
# compose add `web`: it reaches the internal API under that name (#14).
DJANGO_EXTRA_HOSTS=

# synthetic: only invented data, band "Testsystem" on every team page (#26).
# real only once the prerequisites for real data are met (K9 in #23).
DATA_MODE=synthetic

POSTGRES_DB=mymvz
POSTGRES_USER=mymvz
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mail. The console backend prints mails instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For django.core.mail.backends.smtp.EmailBackend:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Sender of all mails to patients
DEFAULT_FROM_EMAIL=termine@example.invalid
# Practice address for "new request" (no content is ever sent)
PRACTICE_NOTIFICATION_EMAIL=praxis@example.invalid

# Voice agent (#13), only with `docker compose --profile voice`.
# Keys of the LiveKit server in compose. Good enough for development; for
# operation long random values (the secret at least 32 characters).
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-change-me-change-me-change-me
# Providers for speech recognition, LLM and speech output. Only `fake`
# until the provider choice in #18.
VOICE_STT_PROVIDER=fake
VOICE_LLM_PROVIDER=fake
VOICE_TTS_PROVIDER=fake
VOICE_LANGUAGE=de-DE
# Internal API of the web app for the agent (#14): information, appointment
# types, checking a preferred day, creating a request. Both services read the
# same key; empty switches the API off. Long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_API_KEY=
VOICE_API_URL=http://web:8000/intern/telefon/
