# Copy to .env and fill in. .env is never committed; the repo is public.

# Long random value, e.g. from:
#   docker compose run --rm --no-deps web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
# 1 only for development
DJANGO_DEBUG=1

# Public host name: mymvz.jnsw.de first, later mymvz.de (#10)
SITE_HOST=mymvz.jnsw.de
# Start of links in e-mails (optional, default https://SITE_HOST).
# In development e.g. http://localhost:8000
SITE_BASE_URL=
# More host names, comma-separated (optional)
DJANGO_EXTRA_HOSTS=

# synthetic: only invented data, band "Testsystem" on every team page (#26).
# real only once the prerequisites for real data are met (K9 in #23).
DATA_MODE=synthetic

POSTGRES_DB=mymvz
POSTGRES_USER=mymvz
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mail. The console backend prints mails instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For django.core.mail.backends.smtp.EmailBackend:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Sender of all mails to patients
DEFAULT_FROM_EMAIL=termine@example.invalid
# Practice address for "new request" (no content is ever sent)
PRACTICE_NOTIFICATION_EMAIL=praxis@example.invalid
