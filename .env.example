# Copy to .env and fill in. .env is never committed; the repo is public.

# Long random value, e.g. from:
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
# 1 only for development
DJANGO_DEBUG=1

# Public host name: mymvz.jnsw.de first, later mymvz.de (#10)
SITE_HOST=mymvz.jnsw.de
# More host names, comma-separated (optional)
DJANGO_EXTRA_HOSTS=

POSTGRES_DB=mymvz
POSTGRES_USER=mymvz
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
